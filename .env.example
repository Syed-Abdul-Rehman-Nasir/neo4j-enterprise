# Bolt connection URI for the Neo4j database
NEO4J_URI=bolt://localhost:7687

# Neo4j authentication username
NEO4J_USERNAME=neo4j

# Neo4j authentication password (use a secrets vault in production)
NEO4J_PASSWORD=changeme_use_vault_in_prod

# Target Neo4j database name
NEO4J_DATABASE=neo4j

# Maximum size of the Neo4j driver connection pool
NEO4J_MAX_POOL_SIZE=50

# Neo4j connection timeout in seconds
NEO4J_CONNECTION_TIMEOUT=30

# Whether to use encrypted Neo4j connections (true/false)
NEO4J_ENCRYPTION=false

# Datadog API key for monitoring integrations
DD_API_KEY=your_datadog_api_key_here

# Datadog application key for monitoring integrations
DD_APP_KEY=your_datadog_app_key_here

# Destination URI for Neo4j backup storage
BACKUP_DESTINATION=s3://your-bucket/neo4j-backups
